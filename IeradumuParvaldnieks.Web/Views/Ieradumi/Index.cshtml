
@model List<IeradumuParvaldnieks.Domain.Entities.Ieradums>

@{
    ViewData["Title"] = "Mani ieradumi";
}

<h1>Mani ieradumi</h1>
<p>Šeit vari apskatīt savus aktīvos ieradumus.</p>

@if (ViewBag.Kluda != null)
{
    <div class="alert alert-danger">
        @ViewBag.Kluda
    </div>
}
else if (Model.Count == 0)
{
    <p>Tev vēl nav neviena aktīva ieraduma.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nosaukums</th>
                <th>Apraksts</th>
                <th>Šodienas statuss</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ieradums in Model)
            {
                <tr>
                    <td>@ieradums.Nosaukums</td>
                    <td>@ieradums.Apraksts</td>
                    <td>
                        @if (ieradums.IrPabeigts(DateTime.Today))
                        {
                            <span class="badge bg-success">Izpildīts</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nav izpildīts</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
